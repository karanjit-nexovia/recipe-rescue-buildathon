# --- Secrets. Never commit. ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Vendored platform SDK ----------------------------------------------------
# .rocketride/ is the RocketRide client + shell tarballs and generated schema,
# fetched per workspace. It is large, machine-generated, and not ours to publish.
.rocketride/

# --- Dependencies and build output --------------------------------------------
**/node_modules/
**/dist/
.wrangler/
**/.wrangler/

# --- OS / editor cruft --------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Wrangler local secrets for `wrangler dev` — same class as .env, never commit.
.dev.vars
**/.dev.vars
.gstack/

# Compiled prompts from scripts/yt-flow.cjs. Regenerated every run.
.tmp/

# Demo recording working files: raw cuts, contact sheets, TTS clips. The finished
# video IS committed so it can be watched from the repo; nothing else here is.
demo/*
!demo/demo-final.mp4
